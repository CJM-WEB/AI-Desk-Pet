{
  "version": "2.0",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "functions": [
    {
      "name": "ai-pet-api",
      "dir": "./apps/cloudbase-api/dist/api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 30
    },
    {
      "name": "ai-pet-cleanup",
      "dir": "./apps/cloudbase-api/dist/cleanup",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 300,
      "triggers": [
        {
          "name": "ai-pet-cleanup-daily",
          "type": "timer",
          "config": "0 0 4 * * * *"
        }
      ]
    }
  ]
}
