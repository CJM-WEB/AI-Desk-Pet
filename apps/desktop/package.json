{
  "name": "@myself/desktop",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "AI Pet 第一阶段 Windows AI 桌宠 Alpha",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/verify-preload-bundle.mjs && node scripts/verify-production-mcp-boundary.mjs",
    "package:win": "pnpm verify:local-model-assets && pnpm build && electron-builder --win nsis --x64 --config electron-builder.yml",
    "stage:local-model": "node scripts/stage-local-model.mjs",
    "verify:local-model-assets": "node scripts/verify-local-model-assets.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "verify:package-config": "vitest run --config vitest.config.ts package-config.test.ts explorer-main-wiring.test.ts",
    "validate:explorer-layer:build": "esbuild tests/fixtures/explorer-window-layer-validation.ts --bundle --platform=node --format=cjs --external:electron --outfile=%TEMP%\\ai-pet-explorer-layer-validation.cjs",
    "validate:explorer-layer:electron": "pnpm validate:explorer-layer:build && node scripts/run-explorer-window-layer-validation.mjs electron manual",
    "validate:explorer-layer:electron:smoke": "pnpm validate:explorer-layer:build && node scripts/run-explorer-window-layer-validation.mjs electron smoke",
    "validate:explorer-candidate:lifecycle": "pnpm validate:explorer-layer:build && node scripts/run-explorer-window-layer-validation.mjs electron lifecycle",
    "validate:explorer-candidate:negative": "pnpm validate:explorer-layer:build && node scripts/run-explorer-window-layer-validation.mjs electron negative",
    "validate:explorer-candidate:accuracy-core": "pnpm validate:explorer-layer:build && node scripts/run-explorer-window-layer-validation.mjs electron accuracy-core"
  },
  "dependencies": {
    "@myself/agent-core": "workspace:*",
    "@myself/character-assets": "workspace:*",
    "@myself/character-runtime": "workspace:*",
    "@myself/file-tools": "workspace:*",
    "@myself/shared-types": "workspace:*",
    "lucide-react": "1.26.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tldts": "7.4.9",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "2.4.5",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1"
  }
}
